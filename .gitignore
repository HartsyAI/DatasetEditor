# Build output (every project, including extensions under src/Extensions)
**/bin/
**/obj/
TestResults/

# Visual Studio / JetBrains / VS Code local state
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/

# Runtime data written by the API when run from the repo (see Storage:* in
# src/APIBackend/Configuration/appsettings*.json). Anchored so that source folders
# with the same names elsewhere in the tree are never ignored.
/data/
/blobs/
/uploads/
/src/APIBackend/data/
/src/APIBackend/blobs/
/src/APIBackend/uploads/

# Local secrets and environment overrides (keep .env.example tracked)
.env
.env.local

# Local tooling and per-user Claude Code state
/.claude/
