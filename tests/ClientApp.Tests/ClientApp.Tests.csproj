<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- This box has only the net10.0 shared runtime installed, not net8.0, so the test host
         crashed with "You must install or update .NET to run this application", meaning
         ClientApp.Tests had never actually executed this session (found Phase 7). RollForward
         lets the net8.0-targeted test host run on the installed net10.0 runtime instead of
         demanding an exact match; safe for a test project, which isn't shipped and doesn't need
         to match the WASM-published ClientApp.dll's own TFM. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ClientApp\ClientApp.csproj" />
    <ProjectReference Include="..\..\src\DTO\DTO.csproj" />
  </ItemGroup>

</Project>
