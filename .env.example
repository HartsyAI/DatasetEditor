# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# .env is gitignored -- never commit real secrets here.

# Postgres
POSTGRES_PASSWORD=change-me-to-a-real-password

# Public domain this deployment is served on. Caddy automatically provisions Let's Encrypt TLS
# for a real domain; left unset/at "localhost" it issues a self-signed certificate instead (see
# Caddyfile). Must also be the origin your users' browsers actually load, since it's used below
# for CORS too.
DOMAIN=localhost

# Admin bootstrap (see AdminBootstrapper -- re-synced on every boot, so changing this and
# restarting the api container is also how you reset a forgotten admin password).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-real-password

# Optional: an S3-compatible storage profile (Phase 5). Leave unset to skip S3 entirely --
# Storage:S3StorageProfiles defaults to an empty array. AllowedBuckets is a comma-free list;
# use additional __N__ indices (S3_PROFILE_ALLOWED_BUCKET_1, _2, ...) for more than one bucket
# in docker-compose.prod.yml's environment block if needed.
# S3_PROFILE_NAME=production-s3
# S3_PROFILE_SERVICE_URL=
# S3_PROFILE_ACCESS_KEY=
# S3_PROFILE_SECRET_KEY=
# S3_PROFILE_ALLOWED_BUCKET_0=
