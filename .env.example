# Copy to .env and fill in real values before running:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# .env is gitignored -- never commit real secrets here.

# Postgres
POSTGRES_PASSWORD=change-me-to-a-real-password

# Database name. Every existing install uses dataset_studio_dev, which is the default here. Choose
# another name only on a fresh install, before the first start. Changing it on an existing install
# makes the API create an empty database (see docs/DEPLOYMENT.md, "Database name").
POSTGRES_DB=dataset_studio_dev

# Public domain this deployment is served on. Caddy automatically provisions Let's Encrypt TLS
# for a real domain; left unset/at "localhost" it issues a self-signed certificate instead (see
# Caddyfile). Must also be the origin your users' browsers actually load, since it's used below
# for CORS too.
DOMAIN=localhost

# Admin bootstrap (see AdminBootstrapper -- re-synced on every boot, so changing this and
# restarting the api container is also how you reset a forgotten admin password).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-real-password

# Whether anyone may create an account from the sign-up page. Off by default: every signed-in
# user can upload large files and start HuggingFace downloads.
ALLOW_REGISTRATION=false

# The compose network's subnet and Caddy's fixed address in it. The API believes the client
# address Caddy forwards only from CADDY_IP. Change both if the range is already used here.
PROXY_SUBNET=172.31.250.0/24
CADDY_IP=172.31.250.10

# S3-compatible storage is not configured from this file. Storage:S3StorageProfiles defaults to an
# empty array; to add a profile, add Storage__S3StorageProfiles__0__* entries to the api service in
# docker-compose.prod.yml (see docs/DEPLOYMENT.md, "S3 storage"). These variables used to be listed
# here but nothing read them (audit R-9).
