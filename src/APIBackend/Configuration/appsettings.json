{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5002",
      "https://localhost:7221",
      "http://localhost:5221"
    ]
  },
  "Storage": {
    "BlobPath": "./blobs",
    "ThumbnailPath": "./blobs/thumbnails",
    "UploadPath": "./uploads",
    "DatasetRootPath": "./data/datasets",
    "DataProtectionKeysPath": "./data/keys",
    "FolderImportRoots": [],
    "S3StorageProfiles": [],
    "S3MaxServeBytes": 67108864
  },
  "RateLimiting": {
    "S3FilePermitsPerMinute": 600,
    "HuggingFaceDiscoverPermitsPerMinute": 10
  },
  "Thumbnails": {
    "MaxCacheBytes": 2147483648,
    "MaxSourceBytes": 67108864,
    "MaxSourcePixels": 100000000,
    "SweepEveryWrites": 500
  },
  "Ingestion": {
    "MaxConcurrentJobs": 2,
    "MaxQueuedJobs": 50,
    "MaxAttempts": 3,
    "PollInterval": "00:01:00",
    "MaxDownloadBytes": 5368709120
  }
}
