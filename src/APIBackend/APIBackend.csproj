<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatasetStudio.APIBackend</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Web API -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />

    <!-- Data Parsing -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- 5.6.1, not the pinned-since-Phase-0 5.3.0: brings in Snappier 1.3.1, fixing
         GHSA-pggp-6c3x-2xmx (Snappier 1.1.6). Stayed within the 5.x major line deliberately,
         since the Phase 1 append-path fix (FileMode.Open/ReadWrite for ParquetWriter.CreateAsync's
         backward-seeking footer rewrite) is tuned against 5.x's behavior; re-verified after
         this bump via the append/streaming/repository test suites, not assumed compatible. -->
    <PackageReference Include="Parquet.Net" Version="5.6.1" />

    <!-- Authentication -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- Thumbnail generation. NoDependencies variant avoids a libfontconfig runtime
         dependency headless Linux boxes frequently lack; we only decode/resize/encode
         raster images, never text/font rendering. -->
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.151.1" />

    <!-- S3 / S3-compatible storage (real AWS S3, MinIO, R2, Backblaze via ServiceURL override) -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.102.1" />

    <!-- Entity Framework Core for PostgreSQL -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\DTO\DTO.csproj" />
    <ProjectReference Include="..\ClientApp\ClientApp.csproj" />
    <!-- API-side extension SDK (IApiExtension, BaseApiExtension) -->
    <ProjectReference Include="..\Extensions\SDK.Api\Extensions.SDK.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project unit-test the streaming parsers directly (e.g. proving a
         parser yields items before consuming its whole source stream) without making
         them public API. -->
    <InternalsVisibleTo Include="APIBackend.Tests" />
  </ItemGroup>

</Project>
