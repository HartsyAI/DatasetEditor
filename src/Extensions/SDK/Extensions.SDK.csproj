<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatasetStudio.Extensions.SDK</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- IApiExtension hands extensions IServiceCollection, IConfiguration and IEndpointRouteBuilder,
         which are ASP.NET Core shared-framework types. The SDK used to be split into a WASM-safe
         half and an API half for client extensions, but nothing ever loaded a client extension,
         so the split was removed with them (audit X-5). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
