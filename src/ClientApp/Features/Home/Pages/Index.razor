@page "/"

<PageTitle>Dashboard - Dataset Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <PageHeader Title="Dashboard"
                Eyebrow="Overview"
                Subtitle="Start a new dataset, go back to the one you had open, or browse your datasets.">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBox"
                       Href="/datasets/create">
                New dataset
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Collections"
                       Href="/datasets">
                Open datasets
            </MudButton>
        </Actions>
    </PageHeader>

    <MudGrid Spacing="3" Class="mb-4">
        <MudItem xs="12" md="4">
            <SectionCard Title="Current session"
                         Subtitle="@(_currentDatasetName ?? "No dataset open")"
                         Icon="@Icons.Material.Filled.Visibility"
                         Elevation="2">
                <ChildContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="6">
                            <StatCard Label="Items" Value="@_totalItems.ToString("N0")" />
                        </MudItem>
                        <MudItem xs="6">
                            <StatCard Label="Selected" Value="@_selectedItems.ToString("N0")" />
                        </MudItem>
                    </MudGrid>
                </ChildContent>
                <Actions>
                    @if (_currentDatasetName is null)
                    {
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/datasets">
                            Open a dataset
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@ResumeViewer">
                            Resume viewer
                        </MudButton>
                    }
                </Actions>
            </SectionCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <SectionCard Title="Datasets"
                         Subtitle="Browse, search and manage your datasets and public ones."
                         Icon="@Icons.Material.Filled.Collections"
                         Elevation="2">
                <Actions>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/datasets">
                        Open datasets
                    </MudButton>
                </Actions>
            </SectionCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <SectionCard Title="AI tools"
                         Subtitle="Auto-captioning, tagging and quality scoring are planned, not built yet."
                         Icon="@Icons.Material.Filled.Bolt"
                         Elevation="2">
                <ChildContent>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Coming soon</MudChip>
                </ChildContent>
                <Actions>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/ai-tools">
                        View status
                    </MudButton>
                </Actions>
            </SectionCard>
        </MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <SectionCard Title="Getting started">
                <MudList T="string" Dense="true" ReadOnly="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.AddBox">
                        Create a dataset from a file upload, a HuggingFace repository, a server folder or an S3 bucket.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Visibility">
                        Open it in the viewer and scroll the virtualised grid or list.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Edit">
                        Select an item to edit its title, tags and favourite in the detail panel.
                    </MudListItem>
                </MudList>
            </SectionCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <SectionCard Title="What it handles">
                <MudList T="string" Dense="true" ReadOnly="true">
                    <MudListItem T="string" Icon="@Icons.Material.Filled.GridView">
                        Large datasets: only a few screens of items are in the page at a time.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.Cloud">
                        Streaming from HuggingFace and S3 without copying the data.
                    </MudListItem>
                    <MudListItem T="string" Icon="@Icons.Material.Filled.FilterList">
                        Search and filter your datasets by status and source.
                    </MudListItem>
                </MudList>
            </SectionCard>
        </MudItem>
    </MudGrid>
</MudContainer>
