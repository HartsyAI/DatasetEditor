@page "/datasets/create"
@attribute [Authorize]

<PageTitle>Create dataset - Dataset Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <PageHeader Title="Create dataset"
                Subtitle="Choose where the items come from, then configure the import." />

    <MudTabs @bind-ActivePanelIndex="_activeStep" Elevation="1" Rounded="true" PanelClass="pa-4">
        <MudTabPanel Text="1. Source">
            <MudGrid Spacing="3" role="group" aria-label="Dataset source">
                @foreach (SourceOption option in _options)
                {
                    <MudItem xs="12" sm="6" md="3" @key="option.Source">
                        <SourceOptionCard Title="@option.Title"
                                          Description="@option.Description"
                                          Icon="@option.Icon"
                                          Selected="@(_selectedSource == option.Source)"
                                          OnSelect="@(() => SelectSource(option.Source))" />
                    </MudItem>
                }
            </MudGrid>

            <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-4">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           EndIcon="@Icons.Material.Filled.ArrowForward"
                           Disabled="@(_selectedSource is null)"
                           OnClick="@Continue">
                    Continue
                </MudButton>
            </MudStack>
        </MudTabPanel>

        <MudTabPanel Text="2. Configure and import" Disabled="@(_selectedSource is null)">
            @if (_selectedSource is CreateSource source)
            {
                <MudStack Spacing="3">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.ArrowBack"
                                   OnClick="@Back">
                            Change source
                        </MudButton>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@SelectedTitle</MudText>
                    </MudStack>
                    <DatasetUploader InitialTabIndex="@UploaderTabIndex(source)" @key="source" />
                </MudStack>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>
