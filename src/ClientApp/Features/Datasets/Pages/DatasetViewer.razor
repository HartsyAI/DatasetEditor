@page "/datasets/{DatasetId:guid}"
@page "/dataset-viewer"

<PageTitle>@(_datasetState.CurrentDataset?.Name ?? "Dataset viewer") - Dataset Studio</PageTitle>

@* Plain root: anchors this page's scoped CSS. The viewer is full bleed (DESIGN.md §3.1). *@
<div class="ds-viewer-root">
    @if (_isLoading)
    {
        <LoadingState Variant="LoadingVariant.Spinner" Message="Loading dataset" />
    }
    else if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="pa-4">
            @if (_requestedDatasetId is not null)
            {
                <ErrorState Title="Couldn't load this dataset" Message="@_errorMessage" OnRetry="@RetryLoadAsync" />
            }
            else
            {
                <ErrorState Title="Couldn't load this dataset" Message="@_errorMessage" />
            }
        </div>
    }
    else if (_datasetState.CurrentDataset == null)
    {
        <EmptyState Headline="No dataset open"
                    Description="Open one from Datasets, or create a new dataset."
                    Icon="@Icons.Material.Filled.Collections">
            <ActionContent>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Collections" Href="/datasets">
                    Open datasets
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBox" Href="/datasets/create">
                    New dataset
                </MudButton>
            </ActionContent>
        </EmptyState>
    }
    else
    {
        @* Full-height row: the item list is the scroll container, so <Virtualize> and the
           end-of-list sentinel both measure against it rather than the whole page. *@
        <div class="ds-viewer-layout">
            <div class="ds-viewer-main">
                @if (_datasetDetail is not null)
                {
                    <IngestionStatusBanner Detail="@_datasetDetail"
                                           IsRefreshing="@_isStatusRefreshing"
                                           OnRefresh="@RefreshStatusAsync" />
                }

                <ViewerToolbar DatasetName="@_datasetState.CurrentDataset.Name"
                               ItemCountLabel="@GetItemCountLabel()"
                               IsBuffering="@_isBuffering"
                               SelectedCount="@_datasetState.SelectedCount"
                               ViewMode="@_viewMode"
                               OnViewModeChanged="@SetViewMode"
                               FiltersOpen="@_viewState.ShowFilterPanel"
                               OnToggleFilters="@_viewState.ToggleFilterPanel"
                               DetailsOpen="@_viewState.ShowDetailPanel"
                               OnToggleDetails="@_viewState.ToggleDetailPanel"
                               IndexedDbEnabled="@_isIndexedDbEnabled"
                               OnIndexedDbChanged="@ToggleOfflineCacheAsync" />

                @if (_viewState.ShowFilterPanel)
                {
                    <MudPaper Elevation="1" Class="pa-3">
                        <FilterPanel />
                    </MudPaper>
                }

                <div class="ds-viewer-items">
                    <ViewerContainer OnItemSelected="@HandleItemSelected"
                                     OnLoadMore="@HandleLoadMoreAsync" />
                </div>
            </div>

            <DetailSidebar Item="@(_datasetState.SelectedItem as DatasetItemDto)"
                           Open="@_viewState.ShowDetailPanel"
                           OnClose="@CloseDetailPanel" />
        </div>
    }
</div>
