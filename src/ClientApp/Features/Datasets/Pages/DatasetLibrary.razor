@page "/my-datasets"
@using DatasetStudio.DTO.Datasets

<PageTitle>@PageTitleText - Dataset Studio</PageTitle>

@* Plain wrapper element so this page's scoped CSS (::deep) has an anchor; MudContainer is a component. *@
<div>
<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <PageHeader Title="@PageTitleText">
        <SubtitleContent>
            @if (_isAuthenticated)
            {
                <span>Your datasets and public datasets shared by others.</span>
            }
            else
            {
                <span>Showing datasets their creators made public. <MudLink Href="/login">Log in</MudLink> to see your own datasets too.</span>
            }
        </SubtitleContent>
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AddBox"
                       Href="/datasets/create">
                New dataset
            </MudButton>
        </Actions>
    </PageHeader>

    <Toolbar>
        <Start>
            <MudTextField T="string"
                          @bind-Value="@_searchQuery"
                          @bind-Value:after="FilterDatasets"
                          Label="Search datasets"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Immediate="true"
                          Class="ds-library-search" />

            <MudSelect T="IngestionStatusDto?" Label="Status" Value="@_statusFilter" ValueChanged="OnStatusFilterChanged"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Class="ds-library-filter">
                <MudSelectItem T="IngestionStatusDto?" Value="@(null)">All statuses</MudSelectItem>
                <MudSelectItem T="IngestionStatusDto?" Value="IngestionStatusDto.Pending">Pending</MudSelectItem>
                <MudSelectItem T="IngestionStatusDto?" Value="IngestionStatusDto.Processing">Processing</MudSelectItem>
                <MudSelectItem T="IngestionStatusDto?" Value="IngestionStatusDto.Completed">Ready</MudSelectItem>
                <MudSelectItem T="IngestionStatusDto?" Value="IngestionStatusDto.Failed">Failed</MudSelectItem>
            </MudSelect>

            <MudSelect T="DatasetSourceType?" Label="Source" Value="@_sourceFilter" ValueChanged="OnSourceFilterChanged"
                       Margin="Margin.Dense" Variant="Variant.Outlined" Class="ds-library-filter">
                <MudSelectItem T="DatasetSourceType?" Value="@(null)">All sources</MudSelectItem>
                <MudSelectItem T="DatasetSourceType?" Value="DatasetSourceType.LocalUpload">Uploaded file</MudSelectItem>
                <MudSelectItem T="DatasetSourceType?" Value="DatasetSourceType.LocalFolder">Server folder</MudSelectItem>
                <MudSelectItem T="DatasetSourceType?" Value="DatasetSourceType.HuggingFaceDownload">HuggingFace (imported)</MudSelectItem>
                <MudSelectItem T="DatasetSourceType?" Value="DatasetSourceType.HuggingFaceStreaming">HuggingFace (streaming)</MudSelectItem>
                <MudSelectItem T="DatasetSourceType?" Value="DatasetSourceType.ExternalS3Streaming">S3 bucket</MudSelectItem>
            </MudSelect>
        </Start>
        <End>
            <MudSwitch T="bool" Value="@_onlyReady" ValueChanged="OnOnlyReadyChanged" Color="Color.Primary" Label="Only ready datasets" />
        </End>
    </Toolbar>

    @if (_isLoading && _datasets.Count == 0)
    {
        <LoadingState Variant="LoadingVariant.CardGrid" Message="Loading datasets" />
    }
    else if (_loadError is not null)
    {
        <ErrorState Title="Couldn't load datasets" Message="@_loadError" OnRetry="@LoadDatasetsAsync" />
    }
    else if (_datasets.Count == 0)
    {
        <EmptyState Headline="No datasets yet"
                    Description="Create a dataset from a file upload, a HuggingFace repository, a server folder or an S3 bucket."
                    Icon="@Icons.Material.Filled.Collections">
            <ActionContent>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AddBox"
                           Href="/datasets/create">
                    New dataset
                </MudButton>
            </ActionContent>
        </EmptyState>
    }
    else if (_filteredDatasets.Count == 0)
    {
        <EmptyState Headline="No datasets match your filters"
                    Description="Try a different search or clear the status and source filters."
                    Icon="@Icons.Material.Filled.FilterList">
            <ActionContent>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ClearFilters">Clear filters</MudButton>
            </ActionContent>
        </EmptyState>
    }
    else
    {
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
        }
        <MudGrid Spacing="3">
            @foreach (DatasetSummaryDto dataset in _filteredDatasets)
            {
                <MudItem xs="12" sm="6" md="4" @key="dataset.Id">
                    <MudCard Elevation="1" Class="dataset-card">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" HtmlTag="h2">@dataset.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @dataset.TotalItems.ToString("N0") items • @(string.IsNullOrWhiteSpace(dataset.Modality) ? "Unknown" : dataset.Modality)
                                </MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <StatusChip Status="@dataset.Status" />
                            </CardHeaderActions>
                        </MudCardHeader>

                        <MudCardContent Class="flex-grow-1">
                            @if (!string.IsNullOrEmpty(dataset.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                                    @GetTruncatedDescription(dataset.Description)
                                </MudText>
                            }
                            <SourceBadge SourceType="@dataset.SourceType" IsStreaming="@dataset.IsStreaming" />
                        </MudCardContent>

                        <MudCardActions>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => ViewDataset(dataset))">
                                Open
                            </MudButton>
                            @if (CanDelete(dataset))
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="@(() => DeleteDatasetAsync(dataset))">
                                    Delete
                                </MudButton>
                            }
                            <MudSpacer />
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Updated @FormatTimeAgo(dataset.UpdatedAt)
                            </MudText>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>
</div>
