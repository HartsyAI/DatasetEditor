@* A single list-view row, virtualized through VirtualizedItemView (Columns = 1). The plain
   root lets ImageListRow.razor.css (scoped) reach the Mud components inside. *@
<div class="ds-list-row-root">
    <MudCard Class="@($"list-item {(IsSelected ? "selected" : string.Empty)}")"
             Elevation="1"
             role="button"
             tabindex="0"
             aria-label="@($"Open {Item.Title}")"
             aria-pressed="@(IsSelected ? "true" : "false")"
             @onclick="HandleClick"
             @onkeydown="HandleKeyDown">
        <div class="list-item-content">
            <div class="thumbnail-container">
                @if (string.IsNullOrEmpty(_thumbnailUrl))
                {
                    <div class="thumbnail-placeholder">
                        <MudIcon Icon="@Icons.Material.Filled.HideImage" Class="mud-text-secondary" />
                    </div>
                }
                else
                {
                    <img src="@_thumbnailUrl" alt="@Item.Title" loading="lazy" decoding="async" />
                }
            </div>

            <div class="metadata-container">
                <MudText Typo="Typo.subtitle1">@Item.Title</MudText>
                <MudText Typo="Typo.body2" Class="description mud-text-secondary">@Item.Description</MudText>

                <MudStack Row="true" Spacing="2" Class="mt-2" Wrap="Wrap.Wrap">
                    @foreach (string fact in Facts)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">@fact</MudChip>
                    }
                </MudStack>

                @if (Item.Tags.Any())
                {
                    <MudStack Row="true" Spacing="1" Class="mt-2" Wrap="Wrap.Wrap">
                        @foreach (string tag in Item.Tags.Take(5))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@tag</MudChip>
                        }
                        @if (Item.Tags.Count > 5)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">+@(Item.Tags.Count - 5) more</MudChip>
                        }
                    </MudStack>
                }
            </div>

            <div class="actions-container" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                <MudTooltip Text="@(Item.IsFavorite ? "Remove from favourites" : "Add to favourites")">
                    <MudIconButton Icon="@(Item.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                                   Color="@(Item.IsFavorite ? Color.Warning : Color.Default)"
                                   aria-label="@(Item.IsFavorite ? "Remove from favourites" : "Add to favourites")"
                                   OnClick="HandleToggleSelect" />
                </MudTooltip>
                @if (!string.IsNullOrEmpty(_imageUrl))
                {
                    <MudTooltip Text="Open the original image">
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Href="@_imageUrl"
                                       Target="_blank"
                                       aria-label="Open the original image" />
                    </MudTooltip>
                }
            </div>
        </div>
    </MudCard>
</div>
