@* Renders the dataset's items for its modality. Images (the only modality ingested today) go
   through VirtualizedItemView as a grid or a list; other modalities say they aren't supported. *@
@if (_modality == Modality.Image)
{
    <VirtualizedItemView Items="DatasetState.Items"
                         ResultSet="DatasetState.ResultSetVersion"
                         Columns="@CurrentColumns"
                         FixedRowHeight="@(_viewMode == ViewMode.List ? ListRowHeight : (double?)null)"
                         OnNearEnd="OnLoadMore">
        <ItemTemplate>
            @if (_viewMode == ViewMode.List)
            {
                <ImageListRow Item="context"
                              IsSelected="@IsItemSelected(context)"
                              OnClick="@(item => HandleItemClick(item))"
                              OnToggleSelect="@(item => HandleToggleSelection(item))" />
            }
            else
            {
                <ImageCard Item="context"
                           IsSelected="@IsItemSelected(context)"
                           OnClick="@(item => HandleItemClick(item))"
                           OnToggleSelect="@(item => HandleToggleSelection(item))"
                           OnEdit="@(item => HandleItemClick(item))" />
            }
        </ItemTemplate>
        <EmptyContent>
            <EmptyState Headline="No items in this dataset"
                        Description="The dataset has no items yet. If it is still importing, they appear when ingestion finishes."
                        Icon="@Icons.Material.Filled.ImageNotSupported" />
        </EmptyContent>
    </VirtualizedItemView>
}
else
{
    <MudAlert Severity="Severity.Info" Class="ma-4">
        Viewing @_modality.ToString().ToLowerInvariant() datasets isn't supported yet; only images are.
    </MudAlert>
}
