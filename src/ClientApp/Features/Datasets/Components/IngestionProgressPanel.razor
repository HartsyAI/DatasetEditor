<MudPaper Elevation="0" Outlined="true" Class="pa-4" role="status" aria-live="polite">
    <MudStack Spacing="2">
        <MudText Typo="Typo.subtitle1">@Title</MudText>
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Status</MudText>
    </MudStack>
</MudPaper>
