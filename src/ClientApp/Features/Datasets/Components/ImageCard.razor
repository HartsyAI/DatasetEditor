@using DatasetStudio.Core.DomainModels
@using DatasetStudio.Core.Utilities
@using DatasetStudio.DTO.Datasets

@* Plain root so ImageCard.razor.css (scoped) can reach the Mud components inside. *@
<div class="ds-image-card-root">
<div class="modern-image-card @(IsSelected ? "selected" : "")"
     role="button"
     tabindex="0"
     aria-label="@($"Open {GetDisplayTitle()}")"
     aria-pressed="@(IsSelected ? "true" : "false")"
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @onfocusin="HandleMouseEnter"
     @onfocusout="HandleMouseLeave"
     @onkeydown="HandleKeyDown"
     @onclick="HandleClick">
    
    @* Favorite star (top-right corner) *@
    @if (_isHovered || Item.IsFavorite)
    {
        <div class="favorite-star ds-on-scrim" @onclick:stopPropagation="true" @onclick="HandleToggleFavorite">
            <MudIcon Icon="@(Item.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" 
                     Color="@(Item.IsFavorite ? Color.Warning : Color.Inherit)"
                     Size="Size.Small" />
        </div>
    }
    
    @* Selection indicator (bottom-left when selected) *@
    @if (IsSelected)
    {
        <div class="selection-indicator">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Medium" />
        </div>
    }
    
    @* Image *@
    <div class="image-container" style="background-color:@PlaceholderColor">
        @if (!string.IsNullOrEmpty(_imageUrl) && !_imageError)
        {
            <img src="@_imageUrl"
                 alt="@Item.Title"
                 loading="lazy"
                 decoding="async"
                 @onload="HandleImageLoaded"
                 @onerror="HandleImageError"
                 class="card-image @(_imageLoaded ? "loaded" : "loading")" />
            @if (!_imageLoaded)
            {
                <div class="image-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" Animation="Animation.Wave" />
                </div>
            }
        }
        else if (_hasNoImage)
        {
            <div class="image-placeholder">
                <MudIcon Icon="@Icons.Material.Filled.HideImage" Class="mud-text-secondary" Size="Size.Large" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">No image</MudText>
            </div>
        }
        else if (_imageError)
        {
            <div class="image-placeholder">
                <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.caption" Color="Color.Error">Failed to load</MudText>
            </div>
        }
        else
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Animation="Animation.Wave" />
        }
    </div>
    
    @* Bottom gradient overlay with title *@
    <div class="bottom-info">
        @if (_isEditingTitle)
        {
            <MudTextField T="string" @bind-Value="_editTitle"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="card-title-input"
                          Immediate="true"
                          AutoFocus="true"
                          OnKeyUp="HandleTitleKeyUp"
                          OnBlur="SaveTitle" />
        }
        else
        {
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.body2" Class="card-title">@GetDisplayTitle()</MudText>
                <div @onclick:stopPropagation="true">
                    <MudTooltip Text="Edit title">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Inherit"
                                       OnClick="StartEditTitle"
                                       aria-label="Edit title" />
                    </MudTooltip>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Item.Photographer()))
        {
            <MudText Typo="Typo.caption" Class="card-subtitle">@Item.Photographer()</MudText>
        }
    </div>
    
    @* Hover overlay with detailed info *@
    @if (_isHovered && ViewState.Settings.ShowMetadataOverlay)
    {
        <div class="hover-details">
            <div class="details-content">
                <div class="details-section">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoSizeSelectActual" Size="Size.Small" Class="detail-icon" />
                    <span>@Item.GetFormattedDimensions()</span>
                </div>
                
                @* TODO: Add FileSizeBytes to DatasetItemDto *@
                @if (!string.IsNullOrEmpty(Item.GetFormattedFileSize()))
                {
                    <div class="details-section">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Class="detail-icon" />
                        <span>@Item.GetFormattedFileSize()</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Item.GetEngagementSummary()))
                {
                    <div class="details-section">
                        <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" Class="detail-icon" />
                        <span>@Item.GetEngagementSummary()</span>
                    </div>
                }
            </div>
            
            @* Quick actions *@
            <div class="hover-actions ds-on-scrim" @onclick:stopPropagation="true">
                <MudTooltip Text="View fullscreen">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="View fullscreen"
                                   OnClick="@(() => HandleClick())" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="Edit"
                                   OnClick="HandleEditClick" />
                </MudTooltip>
                <MudTooltip Text="Download">
                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="Download"
                                   OnClick="HandleDownload" />
                </MudTooltip>
            </div>
        </div>
    }
</div>
</div>
