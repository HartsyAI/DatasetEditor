@using DatasetStudio.Core.DomainModels
@using DatasetStudio.Core.Utilities
@using DatasetStudio.DTO.Datasets

<div class="modern-image-card @(IsSelected ? "selected" : "")" 
     @onmouseenter="HandleMouseEnter"
     @onmouseleave="HandleMouseLeave"
     @onclick="HandleClick">
    
    @* Favorite star (top-right corner) *@
    @if (_isHovered || Item.IsFavorite)
    {
        <div class="favorite-star ds-on-scrim" @onclick:stopPropagation="true" @onclick="HandleToggleFavorite">
            <MudIcon Icon="@(Item.IsFavorite ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)" 
                     Color="@(Item.IsFavorite ? Color.Warning : Color.Inherit)"
                     Size="Size.Small" />
        </div>
    }
    
    @* Selection indicator (bottom-left when selected) *@
    @if (IsSelected)
    {
        <div class="selection-indicator">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Medium" />
        </div>
    }
    
    @* Image *@
    <div class="image-container" style="background-color:@PlaceholderColor">
        @if (!string.IsNullOrEmpty(_imageUrl) && !_imageError)
        {
            <img src="@_imageUrl"
                 alt="@Item.Title"
                 loading="lazy"
                 decoding="async"
                 @onload="HandleImageLoaded"
                 @onerror="HandleImageError"
                 class="card-image @(_imageLoaded ? "loaded" : "loading")" />
            @if (!_imageLoaded)
            {
                <div class="image-skeleton">
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" Animation="Animation.Wave" />
                </div>
            }
        }
        else if (_imageError)
        {
            <div class="image-placeholder">
                <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Color="Color.Error" Size="Size.Large" />
                <MudText Typo="Typo.caption" Color="Color.Error">Failed to load</MudText>
            </div>
        }
        else
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Animation="Animation.Wave" />
        }
    </div>
    
    @* Bottom gradient overlay with title *@
    <div class="bottom-info">
        @if (_isEditingTitle)
        {
            <MudTextField T="string" @bind-Value="_editTitle"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Class="card-title-input"
                          Immediate="true"
                          AutoFocus="true"
                          OnKeyUp="HandleTitleKeyUp"
                          OnBlur="SaveTitle" />
        }
        else
        {
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.body2" Class="card-title">@GetDisplayTitle()</MudText>
                <div @onclick:stopPropagation="true">
                    <MudTooltip Text="Edit title">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Small"
                                       Color="Color.Inherit"
                                       OnClick="StartEditTitle"
                                       aria-label="Edit title" />
                    </MudTooltip>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Item.Photographer()))
        {
            <MudText Typo="Typo.caption" Class="card-subtitle">@Item.Photographer()</MudText>
        }
    </div>
    
    @* Hover overlay with detailed info *@
    @if (_isHovered && ViewState.Settings.ShowMetadataOverlay)
    {
        <div class="hover-details">
            <div class="details-content">
                <div class="details-section">
                    <MudIcon Icon="@Icons.Material.Filled.PhotoSizeSelectActual" Size="Size.Small" Class="detail-icon" />
                    <span>@Item.GetFormattedDimensions()</span>
                </div>
                
                @* TODO: Add FileSizeBytes to DatasetItemDto *@
                @if (!string.IsNullOrEmpty(Item.GetFormattedFileSize()))
                {
                    <div class="details-section">
                        <MudIcon Icon="@Icons.Material.Filled.Storage" Size="Size.Small" Class="detail-icon" />
                        <span>@Item.GetFormattedFileSize()</span>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Item.GetEngagementSummary()))
                {
                    <div class="details-section">
                        <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" Class="detail-icon" />
                        <span>@Item.GetEngagementSummary()</span>
                    </div>
                }
            </div>
            
            @* Quick actions *@
            <div class="hover-actions ds-on-scrim" @onclick:stopPropagation="true">
                <MudTooltip Text="View fullscreen">
                    <MudIconButton Icon="@Icons.Material.Filled.Fullscreen"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="View fullscreen"
                                   OnClick="@(() => HandleClick())" />
                </MudTooltip>
                <MudTooltip Text="Edit">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="Edit"
                                   OnClick="HandleEditClick" />
                </MudTooltip>
                <MudTooltip Text="Download">
                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                   Size="Size.Small"
                                   Color="Color.Inherit"
                                   aria-label="Download"
                                   OnClick="HandleDownload" />
                </MudTooltip>
            </div>
        </div>
    }
</div>

<style>
    .modern-image-card {
        position: relative;
        border-radius: var(--ds-radius-lg);
        overflow: hidden;
        background: var(--mud-palette-surface);
        box-shadow: var(--ds-shadow-card);
        transition: transform var(--ds-transition), box-shadow var(--ds-transition);
        cursor: pointer;
        height: 100%;
    }
    
    .modern-image-card:hover {
        transform: var(--ds-hover-lift);
        box-shadow: var(--ds-shadow-card-hover);
    }
    
    .modern-image-card.selected {
        box-shadow: var(--ds-selection-ring);
    }
    
    .favorite-star {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 10;
        background: var(--ds-scrim);
        backdrop-filter: blur(8px);
        border-radius: 50%;
        padding: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    
    .favorite-star:hover {
        background: var(--ds-scrim-strong);
        transform: scale(1.1);
    }
    
    .selection-indicator {
        position: absolute;
        bottom: 12px;
        left: 12px;
        z-index: 10;
        animation: scaleIn 0.2s ease;
    }
    
    @@keyframes scaleIn {
        from { transform: scale(0); }
        to { transform: scale(1); }
    }
    
    .image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background: var(--mud-palette-background-gray);
    }

    .card-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

    .card-image.loading {
        opacity: 0;
    }

    .card-image.loaded {
        opacity: 1;
    }

    .image-skeleton {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }
    
    .modern-image-card:hover .card-image {
        transform: scale(1.05);
    }
    
    .image-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        background: var(--mud-palette-background-gray);
    }
    
    .bottom-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 16px;
        background: linear-gradient(to top, var(--ds-scrim-strong) 0%, var(--ds-scrim) 50%, transparent 100%);
        color: var(--ds-on-scrim);
        z-index: 5;
    }
    
    .card-title {
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--ds-on-scrim);
        margin-bottom: 2px;
    }
    
    .card-title-input {
        width: 100%;
        color: var(--ds-on-scrim);
    }
    .card-subtitle {
        opacity: 0.9;
        color: var(--ds-on-scrim-muted);
    }
    
    .hover-details {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 16px;
        background: var(--ds-scrim-solid);
        backdrop-filter: blur(4px);
        color: var(--ds-on-scrim);
        z-index: 8;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        animation: fadeIn 0.2s ease;
    }
    
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    
    .details-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-top: 40px;
    }
    
    .details-section {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.875rem;
        color: var(--ds-on-scrim);
    }
    
    .detail-icon {
        opacity: 0.8;
    }
    
    .hover-actions {
        display: flex;
        gap: 8px;
        justify-content: center;
        padding: 8px;
        background: var(--ds-scrim-faint);
        border-radius: var(--ds-radius-md);
    }
</style>
