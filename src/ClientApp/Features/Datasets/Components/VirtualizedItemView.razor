@using Microsoft.AspNetCore.Components.Web.Virtualization
@implements IAsyncDisposable

@* Row-virtualized renderer. Each virtualized item is one row of N items, so Blazor's
   <Virtualize> (which needs a fixed item height) can drive a responsive N-column grid while
   keeping only a few screenfuls of cards in the DOM. The plain root anchors the scoped CSS. *@
<div class="ds-viv-root">
    <div class="viv-container" @ref="_container">
        @if (Items.Count == 0)
        {
            @EmptyContent
        }
        else
        {
            <Virtualize TItem="int" Items="_rowIndices" ItemSize="_rowHeight" OverscanCount="OverscanRows" Context="rowIndex">
                <div class="viv-row" style="grid-template-columns:repeat(@_columns,minmax(0,1fr));">
                    @foreach (DatasetItemDto item in RowItems(rowIndex))
                    {
                        <div class="viv-cell" @key="item.Id">
                            @ItemTemplate(item)
                        </div>
                    }
                </div>
            </Virtualize>
            @* Watched by an IntersectionObserver: when it nears the viewport, OnNearEnd fires.
               This replaces a prefetch call made from inside the row template on every render. *@
            <div class="viv-sentinel" @ref="_sentinel" aria-hidden="true"></div>
        }
    </div>
</div>
