<MudStack Spacing="3">
    <MudStack Spacing="1">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Default view</MudText>
        <MudToggleGroup T="ViewMode"
                        Value="@SelectedViewMode"
                        ValueChanged="@OnViewModeChanged"
                        Color="Color.Primary"
                        Outlined="true"
                        aria-label="Default view">
            <MudToggleItem T="ViewMode" Value="ViewMode.Grid" Text="Grid" />
            <MudToggleItem T="ViewMode" Value="ViewMode.Gallery" Text="Gallery" />
            <MudToggleItem T="ViewMode" Value="ViewMode.List" Text="List" />
        </MudToggleGroup>
    </MudStack>

    <MudStack Spacing="1">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">Grid columns: @GridColumns</MudText>
        <MudSlider T="int"
                   Min="1"
                   Max="8"
                   Step="1"
                   Value="@GridColumns"
                   ValueChanged="@OnGridColumnsChanged"
                   Color="Color.Primary"
                   Immediate="true"
                   aria-label="Grid columns" />
    </MudStack>

    <MudSwitch T="bool"
               Value="@ShowMetadataOverlay"
               ValueChanged="@OnShowMetadataOverlayChanged"
               Color="Color.Primary"
               Label="Show details when hovering an image" />
</MudStack>
