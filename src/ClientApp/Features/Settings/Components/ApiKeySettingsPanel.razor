<MudStack Spacing="2">
    <MudTextField T="string"
                  @bind-Value="_huggingFaceToken"
                  Label="Access token"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  InputType="InputType.Password"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Key"
                  HelperText="Used to read gated or private HuggingFace datasets."
                  OnBlur="SaveHuggingFaceTokenAsync" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        Saved in this browser. It is sent to the Dataset Studio server only with requests that read
        from HuggingFace, and the server passes it on to HuggingFace.
    </MudText>
</MudStack>
