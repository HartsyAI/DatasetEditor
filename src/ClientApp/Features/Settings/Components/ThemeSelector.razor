<MudStack Spacing="2">
    <MudToggleGroup T="ThemeMode"
                    Value="@Value"
                    ValueChanged="@OnValueChangedAsync"
                    Color="Color.Primary"
                    Outlined="true"
                    aria-label="Theme">
        <MudToggleItem T="ThemeMode" Value="ThemeMode.Light" Text="Light" />
        <MudToggleItem T="ThemeMode" Value="ThemeMode.Dark" Text="Dark" />
        <MudToggleItem T="ThemeMode" Value="ThemeMode.Auto" Text="System" />
    </MudToggleGroup>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">
        System follows your operating system's light or dark setting.
    </MudText>
</MudStack>
