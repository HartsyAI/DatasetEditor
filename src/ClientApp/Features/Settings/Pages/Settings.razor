@page "/settings"
@implements IDisposable

<PageTitle>Settings - Dataset Studio</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="px-4 py-4">
    <PageHeader Title="Settings" Subtitle="Preferences are saved in this browser and apply as soon as you change them." />

    <MudGrid Spacing="3">
        <MudItem xs="12" md="4">
            <SectionCard Title="Theme" Icon="@Icons.Material.Filled.DarkMode">
                <ThemeSelector Value="@ViewState.Theme" ValueChanged="@OnThemeChangedAsync" />
            </SectionCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <SectionCard Title="Viewer" Icon="@Icons.Material.Filled.GridView">
                <ViewPreferences SelectedViewMode="@ViewState.ViewMode"
                                 GridColumns="@ViewState.GridColumns"
                                 ShowMetadataOverlay="@ViewState.Settings.ShowMetadataOverlay"
                                 OnViewModeChanged="@OnViewModeChangedAsync"
                                 OnGridColumnsChanged="@OnGridColumnsChangedAsync"
                                 OnShowMetadataOverlayChanged="@OnShowMetadataOverlayChangedAsync" />
            </SectionCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <SectionCard Title="HuggingFace token" Icon="@Icons.Material.Filled.Cloud">
                <ApiKeySettingsPanel />
            </SectionCard>
        </MudItem>
    </MudGrid>
</MudContainer>
