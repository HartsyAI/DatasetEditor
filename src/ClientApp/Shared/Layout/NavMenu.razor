
<MudNavMenu>
    <AuthorizeView>
        <Authorized>
            <MudText Typo="Typo.body2" Class="px-4 pt-2 mud-text-secondary">
                Signed in as <strong>@context.User.Identity?.Name</strong>
            </MudText>
            <MudNavLink OnClick="LogoutAsync" Icon="@Icons.Material.Filled.Logout">
                Log out
            </MudNavLink>
        </Authorized>
        <NotAuthorized>
            <MudNavLink Href="/login" Icon="@Icons.Material.Filled.Login">
                Log in
            </MudNavLink>
            @if (_registrationOpen)
            {
                <MudNavLink Href="/register" Icon="@Icons.Material.Filled.PersonAdd">
                    Register
                </MudNavLink>
            }
        </NotAuthorized>
    </AuthorizeView>
    <MudDivider Class="my-2" />

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>
    
    <MudNavLink Href="/datasets" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Collections">
        Datasets
    </MudNavLink>
    
    <MudNavLink Href="/datasets/create" Icon="@Icons.Material.Filled.AddBox">
        New dataset
    </MudNavLink>
    
    <MudNavLink Href="/ai-tools" Icon="@Icons.Material.Filled.Bolt">
        AI Tools
        <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="ml-2">Coming soon</MudChip>
    </MudNavLink>
    
    <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
        Settings
    </MudNavLink>
    
    <MudDivider Class="my-2" />
    
    <MudNavGroup Title="Recent datasets" Icon="@Icons.Material.Filled.History" Expanded="false">
        @if (_recentDatasets.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="px-4 py-2 mud-text-secondary">
                No recent datasets
            </MudText>
        }
        else
        {
            @foreach (RecentDataset recent in _recentDatasets)
            {
                <MudNavLink Href="@GetDatasetUrl(recent.Id)"
                            Match="NavLinkMatch.All"
                            Icon="@Icons.Material.Filled.Collections"
                            @key="recent.Id">
                    @recent.Name
                </MudNavLink>
            }
        }
    </MudNavGroup>
    
    <MudDivider Class="my-2" />
    
    <MudText Typo="Typo.caption" Class="px-4 py-2 mud-text-disabled">
        v1.0.0-MVP
    </MudText>
</MudNavMenu>

