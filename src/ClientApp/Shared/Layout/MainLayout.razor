@inherits LayoutComponentBase
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" Theme="@AppTheme.Theme" IsDarkMode="@_isDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudDrawer @bind-Open="@_drawerOpen"
               Elevation="2"
               ClipMode="DrawerClipMode.Always"
               Class="ds-nav-drawer">
        <MudDrawerHeader>
            <MudText Typo="Typo.h6">Dataset Studio</MudText>
            <MudSpacer />
            <MudTooltip Text="Collapse navigation">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Color="Color.Inherit"
                               OnClick="@ToggleDrawer"
                               aria-label="Collapse navigation" />
            </MudTooltip>
        </MudDrawerHeader>
        <NavMenu />
        <MudButton Variant="Variant.Text"
                   Color="Color.Default"
                   Size="Size.Small"
                   StartIcon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                   OnClick="@ToggleThemeAsync"
                   Class="mx-2 mb-2 align-self-start">
            @ThemeToggleLabel
        </MudButton>
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
            @if (!_drawerOpen)
            {
                <MudTooltip Text="Open navigation">
                    <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                   Color="Color.Default"
                                   Class="ma-2"
                                   OnClick="@ToggleDrawer"
                                   aria-label="Open navigation" />
                </MudTooltip>
            }

            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
