<MudDialog>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.h5" HtmlTag="h2">@Title</MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary">@Message</MudText>
            @if (!string.IsNullOrWhiteSpace(SecondaryMessage))
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@SecondaryMessage</MudText>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   Color="Color.Secondary"
                   OnClick="@Cancel">
            @CancelLabel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(Destructive ? Color.Error : Color.Primary)"
                   OnClick="@Confirm">
            @ConfirmLabel
        </MudButton>
    </DialogActions>
</MudDialog>
