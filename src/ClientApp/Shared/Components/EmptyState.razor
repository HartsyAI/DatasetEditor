<MudPaper Elevation="0" Class="pa-8">
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="text-center">
        <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Secondary" />
        <MudText Typo="Typo.h6" HtmlTag="h2">@Headline</MudText>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@Description</MudText>
        }
        @if (ActionContent is not null)
        {
            <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="mt-2">
                @ActionContent
            </MudStack>
        }
    </MudStack>
</MudPaper>
