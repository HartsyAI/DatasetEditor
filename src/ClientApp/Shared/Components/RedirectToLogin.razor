@* Rendered by AuthorizeRouteView's <NotAuthorized> when an anonymous visitor hits an
   [Authorize]-gated page (e.g. Create Dataset). Immediately navigates to /login rather than
   showing a dead-end "not authorized" page. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(Navigation.Uri)}");
    }
}
