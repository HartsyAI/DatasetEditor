<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatasetStudio.ClientApp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor WebAssembly -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />

    <!-- MudBlazor UI Framework -->
    <PackageReference Include="MudBlazor" Version="7.8.0" />

    <!-- LocalStorage for browser storage -->
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />

    <!-- CSV/TSV parsing -->
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Core and DTO libraries -->
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\DTO\DTO.csproj" />
  </ItemGroup>

</Project>
