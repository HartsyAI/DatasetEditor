<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DatasetStudio.ClientApp</RootNamespace>
    <!-- These are the MudBlazor v6-vs-v7 mismatches and missing-component diagnostics that
         hid broken controls (audit U-3, U-4). Errors, so a new one fails the build rather than
         shipping a silently ignored parameter. See DESIGN.md section 1.1. -->
    <WarningsAsErrors>$(WarningsAsErrors);MUD0001;MUD0002;RZ10012</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blazor WebAssembly -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.14" />

    <!-- MudBlazor UI Framework -->
    <PackageReference Include="MudBlazor" Version="7.8.0" />

    <!-- LocalStorage for browser storage -->
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Core and DTO libraries -->
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\DTO\DTO.csproj" />
  </ItemGroup>

</Project>
